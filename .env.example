# Copy to .env (never commit it).
ENVIRONMENT=production
APP_BASE_URL=https://app.example.com
# Optional on a single instance: when unset, keys are generated on first boot into
# DATA_DIR/instance_keys.json (keep DATA_DIR on a persistent volume and back it up).
# Required when running several replicas: generate with `semanticone generate-key`.
SECRET_KEY=
ENCRYPTION_KEY=
DATABASE_URL=postgresql://user:password@host:5432/semanticone
DATA_DIR=/data

# Stripe (optional; without it upgrades go through sales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email for password resets and invitations (optional; links are logged when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SemanticOne <no-reply@example.com>

# Operators who get the /admin console (comma-separated)
ADMIN_EMAILS=you@example.com

# Business details shown in the app
LEGAL_ENTITY=Your Company LLC
SALES_EMAIL=sales@example.com
SUPPORT_EMAIL=support@example.com

# Behaviour
SIGNUPS_ENABLED=true
QUERY_TIMEOUT_SECONDS=60
# Only for self-hosted/VPC deployments that must reach private warehouses:
ALLOW_PRIVATE_NETWORKS=false
